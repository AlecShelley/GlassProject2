# FIRE 2.0 (Guenole 2020) — Bidisperse N=1000000, phi=0.860

dimension       2
units           lj
atom_style      atomic
boundary        p p p

variable        L equal 1162.589972
region          box block 0 $L 0 $L -0.5 0.5
create_box      2 box
create_atoms    1 random 1000000 42 box

set             group all type/fraction 2 0.5 12345

mass            1 1.0
mass            2 1.0

pair_style      table linear 10000
pair_coeff      1 1 harmonic_repulsive_bidisperse.table HARM_SS 1.4
pair_coeff      1 2 harmonic_repulsive_bidisperse.table HARM_SL 1.4
pair_coeff      2 2 harmonic_repulsive_bidisperse.table HARM_LL 1.4

fix             f2d all enforce2d
timestep        0.001

thermo          1000
thermo_style    custom step pe press fmax cpu

min_style       fire

minimize        1.0e-12 1.0e-8 200000 1000000

print "FINAL_ENERGY: $(pe)"
print "FINAL_FMAX: $(fmax)"
