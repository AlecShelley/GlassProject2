#!/bin/bash
#SBATCH --job-name=async_fire_10x10
#SBATCH --partition=normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=fire_run_%j.out
#SBATCH --error=fire_run_%j.err

set -euo pipefail

# Load a Python 3.9 stack compatible with numba and matplotlib on Sherlock.
module --force purge
module load math
module load devel
module load py-numpy/1.24.2_py39
module load py-numba/0.59.1_py39
module load viz
module load py-matplotlib/3.7.1_py39

echo "Starting 100-run Async FIRE Parameter Sweep on Sherlock..."
cd "$SLURM_SUBMIT_DIR"
python3 asynch_fire_compute.py
python3 render_dashboard.py
echo "Job Complete."
